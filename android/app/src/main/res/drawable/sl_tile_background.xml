<?xml version="1.0" encoding="utf-8"?>
<!-- Status light console tile: a thick light ring shows controller focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/sl_plate_high" />
            <stroke android:width="3dp" android:color="@color/sl_frost" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/sl_plate_high" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/sl_plate" />
        </shape>
    </item>
</selector>
