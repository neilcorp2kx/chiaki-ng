<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="drawableIdle" format="reference" />
    <attr name="drawablePressed" format="reference" />

    <declare-styleable name="ButtonView">
        <attr name="drawableIdle" />
        <attr name="drawablePressed" />
    </declare-styleable>

    <declare-styleable name="AnalogStickView">
        <attr name="radius" format="dimension" />
        <attr name="handleRadius" format="dimension" />
        <attr name="drawableBase" format="reference" />
        <attr name="drawableHandle" format="reference" />
    </declare-styleable>

    <declare-styleable name="TouchpadView">
        <attr name="drawableIdle" />
        <attr name="drawablePressed" />
    </declare-styleable>

    <!-- Set by each look's theme (see AppStyle) -->
    <attr name="streamBandBackground" format="reference" />
    <attr name="streamCardBackground" format="reference" />
    <attr name="streamTextColor" format="color" />
    <attr name="streamMenuButtonBackground" format="reference" />
    <!-- Settings and forms of the Status light and Console home looks -->
    <attr name="lookTitleFont" format="reference" />
    <attr name="lookSettingsBackground" format="reference" />
    <attr name="lookRowBackground" format="reference" />
    <attr name="lookRailItemBackground" format="reference" />
    <attr name="lookSheetBackground" format="reference" />
    <attr name="lookDividerColor" format="color" />
</resources>