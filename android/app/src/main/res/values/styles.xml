<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">?attr/colorPrimarySurface</item>
        <item name="android:navigationBarColor">?attr/colorPrimarySurface</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialog.NonMaterial</item>

        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="AppTheme.Toolbar" parent="AppTheme">
        <item name="android:textColorSecondary">#fff</item>
    </style>

    <style name="AppTheme.FloatingActionButtonSpeedDial">
        <item name="tint">@color/floating_action_button_speed_dial_tint</item>
        <item name="android:backgroundTint">@color/floating_action_button_speed_dial_background</item>
        <item name="android:textColor">@color/floating_action_button_speed_dial_tint</item>
    </style>

    <style name="AppTheme.AlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="materialButtonStyle">@style/AppTheme.AlertDialog.Button</item>
    </style>

    <style name="AppTheme.AlertDialog.NonMaterial" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@android:color/primary_text_dark</item>
        <item name="materialButtonStyle">@style/AppTheme.AlertDialog.Button</item>
        <item name="colorControlActivated">@color/accent</item>
    </style>

    <style name="AppTheme.AlertDialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="MageTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorPrimarySurface">@color/primary</item>
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">?attr/colorPrimarySurface</item>
        <item name="android:navigationBarColor">?attr/colorPrimarySurface</item>
        <item name="colorControlNormal">@color/accent</item>
        <item name="colorButtonNormal">@color/accent</item>
        <item name="android:textAppearanceButton">@style/MageTheme.TextAppearanceButton</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>

        <item name="textAppearanceHeadline1">@style/MageTheme.TextAppearanceHeadline1</item>

        <item name="android:colorControlActivated">?attr/colorAccent</item>
        <item name="android:colorControlHighlight">?attr/colorAccent</item>

        <item name="textInputStyle">@style/MageTheme.TextInputStyle</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
    </style>

    <style name="MageTheme.Translucent" parent="MageTheme">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="MageTheme.TextAppearanceHeadline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">sans-serif-condensed-light</item>
    </style>

    <style name="MageTheme.TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="hintTextColor">?attr/colorAccent</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxStrokeColor">@color/mage_text_input_box_stroke</item>
        <item name="boxBackgroundColor">?attr/colorPrimaryDark</item>
    </style>

    <style name="MageTheme.TextInputStyle.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="hintTextColor">?attr/colorAccent</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxStrokeColor">@color/mage_text_input_box_stroke</item>
        <item name="boxBackgroundColor">?attr/colorPrimaryDark</item>
    </style>

    <style name="MageTheme.Button" parent="Widget.MaterialComponents.Button">
        <item name="tint">?attr/colorOnSecondary</item>
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="iconTint">?attr/colorOnSecondary</item>
    </style>

    <style name="MageTheme.TextAppearanceButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <style name="StreamTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="android:windowBackground">@color/stream_background</item>
    </style>

    <!-- "Status light" look (AppStyle.STATUS_LIGHT) -->
    <style name="StatusLightTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/sl_plate</item>
        <item name="colorPrimaryDark">@color/sl_graphite</item>
        <item name="colorAccent">@color/sl_frost</item>
        <item name="colorOnPrimary">@color/sl_frost</item>
        <item name="colorSecondary">@color/sl_frost</item>
        <item name="colorOnSecondary">@color/sl_graphite</item>
        <item name="colorSurface">@color/sl_plate</item>
        <item name="colorOnSurface">@color/sl_frost</item>
        <item name="colorPrimarySurface">@color/sl_graphite</item>
        <item name="colorControlNormal">@color/sl_haze</item>
        <item name="colorControlActivated">@color/sl_frost</item>
        <item name="android:colorBackground">@color/sl_graphite</item>
        <item name="android:windowBackground">@color/sl_graphite</item>
        <item name="android:textColorPrimary">@color/sl_frost</item>
        <item name="android:textColorSecondary">@color/sl_haze</item>
        <item name="android:statusBarColor">@color/sl_graphite</item>
        <item name="android:navigationBarColor">@color/sl_graphite</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="materialAlertDialogTheme">@style/StatusLightTheme.AlertDialog</item>
        <item name="alertDialogTheme">@style/StatusLightTheme.AlertDialog.NonMaterial</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="preferenceTheme">@style/LookPreferenceTheme</item>
        <item name="lookTitleFont">@font/archivo_wide</item>
        <item name="lookSettingsBackground">@color/sl_graphite</item>
        <item name="lookRowBackground">@drawable/sl_row_background</item>
        <item name="lookRailItemBackground">@drawable/sl_rail_item_background</item>
        <item name="lookSheetBackground">@drawable/sl_sheet_background</item>
        <item name="lookDividerColor">@color/sl_plate</item>
    </style>

    <style name="StatusLightTheme.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/sl_plate</item>
        <item name="colorOnSurface">@color/sl_frost</item>
        <item name="colorPrimary">@color/sl_frost</item>
        <item name="colorAccent">@color/sl_frost</item>
        <item name="android:textColorPrimary">@color/sl_frost</item>
        <item name="android:textColorSecondary">@color/sl_haze</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <style name="StatusLightTheme.AlertDialog.NonMaterial" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">@color/sl_plate</item>
        <item name="colorAccent">@color/sl_frost</item>
        <item name="colorControlActivated">@color/sl_frost</item>
        <item name="android:textColorPrimary">@color/sl_frost</item>
        <item name="android:textColorSecondary">@color/sl_haze</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <style name="StreamTheme.StatusLight">
        <item name="colorAccent">@color/sl_frost</item>
        <item name="colorSecondary">@color/sl_frost</item>
        <item name="colorControlActivated">@color/sl_frost</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="materialAlertDialogTheme">@style/StatusLightTheme.AlertDialog</item>
        <item name="streamBandBackground">@drawable/sl_band</item>
        <item name="streamCardBackground">@drawable/sl_stream_card</item>
        <item name="streamTextColor">@color/sl_frost</item>
    </style>

    <!-- "Console home" look (AppStyle.CONSOLE_HOME) -->
    <style name="ConsoleHomeTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/ch_deep</item>
        <item name="colorPrimaryDark">@color/ch_midnight</item>
        <item name="colorAccent">@color/ch_glow</item>
        <item name="colorOnPrimary">@color/ch_lumen</item>
        <item name="colorSecondary">@color/ch_glow</item>
        <item name="colorOnSecondary">@color/ch_lumen</item>
        <item name="colorSurface">@color/ch_card</item>
        <item name="colorOnSurface">@color/ch_lumen</item>
        <item name="colorPrimarySurface">@color/ch_midnight</item>
        <item name="colorControlNormal">@color/ch_mist</item>
        <item name="colorControlActivated">@color/ch_glow</item>
        <item name="android:colorBackground">@color/ch_midnight</item>
        <item name="android:windowBackground">@color/ch_midnight</item>
        <item name="android:textColorPrimary">@color/ch_lumen</item>
        <item name="android:textColorSecondary">@color/ch_mist</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/mukta</item>
        <item name="materialAlertDialogTheme">@style/ConsoleHomeTheme.AlertDialog</item>
        <item name="alertDialogTheme">@style/ConsoleHomeTheme.AlertDialog.NonMaterial</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="preferenceTheme">@style/LookPreferenceTheme</item>
        <item name="lookTitleFont">@font/mukta_extralight</item>
        <item name="lookSettingsBackground">@drawable/ch_settings_background</item>
        <item name="lookRowBackground">@drawable/ch_row_background</item>
        <item name="lookRailItemBackground">@drawable/ch_rail_item_background</item>
        <item name="lookSheetBackground">@drawable/ch_sheet_background</item>
        <item name="lookDividerColor">#2EA9B8D6</item>
    </style>

    <style name="ConsoleHomeTheme.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/ch_card</item>
        <item name="colorOnSurface">@color/ch_lumen</item>
        <item name="colorPrimary">@color/ch_lumen</item>
        <item name="colorAccent">@color/ch_glow</item>
        <item name="android:textColorPrimary">@color/ch_lumen</item>
        <item name="android:textColorSecondary">@color/ch_mist</item>
        <item name="android:fontFamily">@font/mukta</item>
        <item name="shapeAppearanceMediumComponent">@style/ConsoleHomeTheme.DialogShape</item>
    </style>

    <style name="ConsoleHomeTheme.DialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ConsoleHomeTheme.AlertDialog.NonMaterial" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">@color/ch_card</item>
        <item name="colorAccent">@color/ch_glow</item>
        <item name="colorControlActivated">@color/ch_glow</item>
        <item name="android:textColorPrimary">@color/ch_lumen</item>
        <item name="android:textColorSecondary">@color/ch_mist</item>
        <item name="android:fontFamily">@font/mukta</item>
    </style>

    <style name="StreamTheme.ConsoleHome">
        <item name="colorAccent">@color/ch_glow</item>
        <item name="colorSecondary">@color/ch_glow</item>
        <item name="colorControlActivated">@color/ch_glow</item>
        <item name="android:fontFamily">@font/mukta</item>
        <item name="materialAlertDialogTheme">@style/ConsoleHomeTheme.AlertDialog</item>
        <item name="streamBandBackground">@drawable/ch_band</item>
        <item name="streamCardBackground">@drawable/ch_stream_card</item>
        <item name="streamTextColor">@color/ch_lumen</item>
    </style>

    <!-- Text styles of the two looks -->
    <style name="StatusLight" />
    <style name="StatusLight.Display">
        <item name="android:fontFamily">@font/archivo_wide</item>
        <item name="android:textColor">@color/sl_frost</item>
    </style>
    <style name="StatusLight.Body">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:textColor">@color/sl_haze</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="StatusLight.Button">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/sl_frost</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/sl_button</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/sl_frost</item>
    </style>

    <style name="StreamCard">
        <item name="android:background">?attr/streamCardBackground</item>
        <item name="android:textColor">?attr/streamTextColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="ConsoleHome" />
    <style name="ConsoleHome.Name">
        <item name="android:fontFamily">@font/mukta_extralight</item>
        <item name="android:textColor">@color/ch_lumen</item>
    </style>
    <style name="ConsoleHome.Body">
        <item name="android:fontFamily">@font/mukta</item>
        <item name="android:textColor">@color/ch_mist</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="ConsoleHome.Pill">
        <item name="android:fontFamily">@font/mukta_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ConsoleHome.Pill.Primary">
        <item name="android:background">@drawable/ch_pill_primary</item>
        <item name="android:textColor">@color/ch_midnight</item>
    </style>
    <style name="ConsoleHome.Pill.Glass">
        <item name="android:background">@drawable/ch_pill_glass</item>
        <item name="android:textColor">@color/ch_pill_glass_content</item>
    </style>
    <style name="ConsoleHome.IconButton">
        <item name="android:background">@drawable/ch_pill_glass</item>
        <item name="android:padding">12dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="tint">@color/ch_pill_glass_content</item>
    </style>

    <!-- Settings rows of the Status light and Console home looks (preferenceTheme) -->
    <style name="LookPreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/LookPreference</item>
        <item name="preferenceCategoryStyle">@style/LookPreference.Category</item>
        <item name="switchPreferenceStyle">@style/LookPreference.Switch</item>
        <item name="switchPreferenceCompatStyle">@style/LookPreference.Switch</item>
        <item name="dialogPreferenceStyle">@style/LookPreference.Dialog</item>
        <item name="editTextPreferenceStyle">@style/LookPreference.Dialog</item>
    </style>
    <style name="LookPreference" parent="Preference.Material">
        <item name="android:layout">@layout/look_pref_row</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="LookPreference.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/look_pref_category</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="LookPreference.Switch" parent="Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/look_pref_row</item>
        <item name="android:widgetLayout">@layout/look_pref_lamp</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="LookPreference.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/look_pref_row</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- Choice panel (LookChoiceSheet) -->
    <style name="LookSheetDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowIsFloating">true</item>
    </style>
    <style name="LookSheetAnimation" />
    <style name="LookSheetAnimation.End">
        <item name="android:windowEnterAnimation">@anim/look_sheet_in_end</item>
        <item name="android:windowExitAnimation">@anim/look_sheet_out_end</item>
    </style>
    <style name="LookSheetAnimation.Bottom">
        <item name="android:windowEnterAnimation">@anim/look_sheet_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/look_sheet_out_bottom</item>
    </style>

    <!-- Register and add-by-address screens in the two looks -->
    <style name="MageTheme.StatusLight">
        <item name="colorPrimary">@color/sl_graphite</item>
        <item name="colorPrimaryDark">@color/sl_graphite</item>
        <item name="colorAccent">@color/sl_frost</item>
        <item name="colorOnPrimary">@color/sl_frost</item>
        <item name="colorSecondary">@color/sl_frost</item>
        <item name="colorOnSecondary">@color/sl_graphite</item>
        <item name="colorPrimarySurface">@color/sl_graphite</item>
        <item name="colorSurface">@color/sl_plate</item>
        <item name="colorOnSurface">@color/sl_frost</item>
        <item name="android:windowBackground">@color/sl_graphite</item>
        <item name="colorControlNormal">@color/sl_haze</item>
        <item name="colorButtonNormal">@color/sl_frost</item>
        <item name="android:textColorPrimary">@color/sl_frost</item>
        <item name="android:textColorSecondary">@color/sl_haze</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="textAppearanceHeadline1">@style/MageTheme.StatusLight.Headline</item>
        <item name="textInputStyle">@style/MageTheme.StatusLight.TextInput</item>
        <item name="materialAlertDialogTheme">@style/StatusLightTheme.AlertDialog</item>
        <item name="lookTitleFont">@font/archivo_wide</item>
    </style>
    <style name="MageTheme.StatusLight.Headline" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:fontFamily">@font/archivo_wide</item>
        <item name="fontFamily">@font/archivo_wide</item>
    </style>
    <style name="MageTheme.StatusLight.TextInput" parent="MageTheme.TextInputStyle">
        <item name="boxBackgroundColor">@color/sl_plate</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
    </style>

    <style name="MageTheme.ConsoleHome">
        <item name="colorPrimary">@color/ch_midnight</item>
        <item name="colorPrimaryDark">@color/ch_midnight</item>
        <item name="colorAccent">@color/ch_glow</item>
        <item name="colorOnPrimary">@color/ch_lumen</item>
        <item name="colorSecondary">@color/ch_lumen</item>
        <item name="colorOnSecondary">@color/ch_midnight</item>
        <item name="colorPrimarySurface">@color/ch_midnight</item>
        <item name="colorSurface">@color/ch_card</item>
        <item name="colorOnSurface">@color/ch_lumen</item>
        <item name="android:windowBackground">@drawable/ch_settings_background</item>
        <item name="colorControlNormal">@color/ch_mist</item>
        <item name="colorButtonNormal">@color/ch_lumen</item>
        <item name="android:textColorPrimary">@color/ch_lumen</item>
        <item name="android:textColorSecondary">@color/ch_mist</item>
        <item name="android:fontFamily">@font/mukta</item>
        <item name="textAppearanceHeadline1">@style/MageTheme.ConsoleHome.Headline</item>
        <item name="textInputStyle">@style/MageTheme.ConsoleHome.TextInput</item>
        <item name="materialAlertDialogTheme">@style/ConsoleHomeTheme.AlertDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="lookTitleFont">@font/mukta_extralight</item>
    </style>
    <style name="MageTheme.ConsoleHome.Headline" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:fontFamily">@font/mukta_extralight</item>
        <item name="fontFamily">@font/mukta_extralight</item>
    </style>
    <style name="MageTheme.ConsoleHome.TextInput" parent="MageTheme.TextInputStyle">
        <item name="boxBackgroundColor">@color/ch_card</item>
        <item name="hintTextColor">@color/ch_lumen</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
    </style>
</resources>
