<?xml version="1.0" encoding="utf-8"?>
<!-- Connecting, Console home look: light gathers into a breathing ring -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_midnight"
    android:clickable="true">

    <com.metallic.chiaki.looks.AmbientBackgroundView
        android:id="@+id/ambientView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.metallic.chiaki.looks.OrbView
            android:id="@+id/orbView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="96dp" />

        <TextView
            android:id="@+id/nameTextView"
            style="@style/ConsoleHome.Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="40sp"
            tools:text="PS5-962" />

        <TextView
            android:id="@+id/stepTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/mukta"
            android:gravity="center"
            android:textColor="@color/ch_lumen"
            android:textSize="19sp"
            tools:text="Asking the console to start" />

        <TextView
            android:id="@+id/detailTextView"
            style="@style/ConsoleHome.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="520dp"
            android:minLines="2"
            android:textSize="14sp"
            tools:text="This can take up to 30 seconds if it is in rest mode." />

        <com.metallic.chiaki.looks.LightStripView
            android:id="@+id/trackView"
            android:layout_width="260dp"
            android:layout_height="16dp"
            android:layout_marginTop="10dp" />

        <TextView
            style="@style/ConsoleHome.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connect_cancel_hint"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
