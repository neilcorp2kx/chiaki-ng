<?xml version="1.0" encoding="utf-8"?>
<!-- Consoles screen of the Console home look: a home row of consoles over an ambient backdrop -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_midnight">

    <com.metallic.chiaki.looks.AmbientBackgroundView
        android:id="@+id/ambientView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@font/mukta_semibold"
                android:maxLines="1"
                android:text="@string/home_title"
                android:textColor="@color/ch_lumen"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/accountTextView"
                style="@style/ConsoleHome.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textSize="14sp"
                tools:text="@string/home_psn_signed_in" />

            <ImageView
                android:id="@+id/findButton"
                style="@style/ConsoleHome.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_look_find" />

            <ImageView
                android:id="@+id/settingsButton"
                style="@style/ConsoleHome.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/home_settings"
                android:src="@drawable/ic_look_settings" />

            <TextClock
                android:id="@+id/clock"
                style="@style/ConsoleHome.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ch_lumen" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tilesScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tilesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="top"
                android:minHeight="156dp"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/heroLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/heroNameTextView"
                style="@style/ConsoleHome.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="54sp"
                tools:text="PS5-962" />

            <TextView
                android:id="@+id/heroStateTextView"
                style="@style/ConsoleHome.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxWidth="640dp"
                android:textSize="18sp"
                tools:text="Ready to play, away from home over PSN" />

            <TextView
                android:id="@+id/heroAppTextView"
                style="@style/ConsoleHome.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Playing Astro Bot" />

            <LinearLayout
                android:id="@+id/actionsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/primaryButton"
                    style="@style/ConsoleHome.Pill.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/action_play" />

                <TextView
                    android:id="@+id/secondaryButton"
                    style="@style/ConsoleHome.Pill.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/action_stream_settings" />

                <ImageView
                    android:id="@+id/optionsButton"
                    style="@style/ConsoleHome.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_look_more" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hintTextView"
            style="@style/ConsoleHome.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="14dp"
            android:text="@string/home_hint_console_home"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
