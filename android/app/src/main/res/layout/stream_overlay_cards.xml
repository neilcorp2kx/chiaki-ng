<?xml version="1.0" encoding="utf-8"?>
<!-- Stream controls of the Status light and Console home looks: cards in the band below the picture.
     Same view IDs as the Classic overlay in activity_stream.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/streamBandBackground"
        android:clickable="true"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="false"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <!-- Centered while the cards fit, scrolls from the first card when they do not -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/cardsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="10dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/onScreenControlsSwitch"
                style="@style/StreamCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stream_on_screen_controls"
                app:switchPadding="10dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/touchpadOnlySwitch"
                style="@style/StreamCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stream_touchpad_only"
                app:switchPadding="10dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/microphoneSwitch"
                style="@style/StreamCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stream_microphone"
                app:switchPadding="10dp" />

            <FrameLayout
                style="@style/StreamCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/displayModeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    app:checkedButton="@id/display_mode_normal_button"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/display_mode_normal_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/stream_display_fit"
                        app:icon="@drawable/ic_display_normal"
                        app:iconTint="@color/stream_material_button_icon_tint"
                        app:strokeColor="?attr/streamTextColor" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/display_mode_zoom_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/stream_display_zoom"
                        app:icon="@drawable/ic_display_zoom"
                        app:iconTint="@color/stream_material_button_icon_tint"
                        app:strokeColor="?attr/streamTextColor" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/display_mode_stretch_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/stream_display_stretch"
                        app:icon="@drawable/ic_display_stretch"
                        app:iconTint="@color/stream_material_button_icon_tint"
                        app:strokeColor="?attr/streamTextColor" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </FrameLayout>

            <TextView
                android:id="@+id/arrangeButton"
                style="@style/StreamCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/stream_arrange_controls" />

            <TextView
                android:id="@+id/leaveButton"
                style="@style/StreamCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/stream_leave" />
        </LinearLayout>
        </FrameLayout>
    </HorizontalScrollView>
</FrameLayout>
